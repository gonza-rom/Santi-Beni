# ─── Cloudinary (fotos de la galería) ───────────────────────────────
# Nombre de la cuenta (público). Vacío = la web usa las fotos de public/images/viaje.
NEXT_PUBLIC_CLOUDINARY_CLOUD=
# Upload preset sin firma (Cloudinary → Settings → Upload → Upload presets), para scripts/upload-cloudinary.mjs
CLOUDINARY_UPLOAD_PRESET=
# Alternativa firmada (SECRETA, solo local): cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=

# "Ahora mismo" editable sin código: Google Sheets → Archivo → Compartir → Publicar en la web → CSV.
# Filas: lugar | detalle | fecha | foto   (foto: clave tipo v42, o una URL de imagen)
NOW_SHEET_URL=

# Clave para forzar la actualización al instante: /api/revalidate?secret=ESTA_CLAVE (inventá una larga)
REVALIDATE_SECRET=
