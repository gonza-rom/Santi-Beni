# ─── Cloudinary (fotos de la galería) ───────────────────────────────
# Nombre de la cuenta (público). Vacío = la web usa las fotos de public/images/viaje.
NEXT_PUBLIC_CLOUDINARY_CLOUD=
# Upload preset sin firma (Cloudinary → Settings → Upload → Upload presets), para scripts/upload-cloudinary.mjs
CLOUDINARY_UPLOAD_PRESET=
# Alternativa firmada (SECRETA, solo local): cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=
